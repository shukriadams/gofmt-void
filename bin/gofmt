#!/usr/bin/env python3

# nothing else to see here yet
# overwrite /usr/local/go/bin/gofmt and make executable

import sys
import os
import codecs

log_file=''
log_file_path='/tmp/gofmt_void.log'
if os.path.isfile(log_file_path):
    with codecs.open(log_file_path, encoding='utf-8') as file:
        log_file = file.read()

args_flat = ' // '.join(sys.argv)
log_file= f'{log_file}\n{args_flat}'
with open(log_file_path, 'w') as output:
    output.write(log_file)

write_to_file=False
for arg in sys.argv:
    if arg == '-w':
        write_to_file=True
        break

if not write_to_file and len(sys.argv) > 1:
    target_file = sys.argv[1]
    if os.path.isfile(target_file):
        with codecs.open(target_file, encoding='utf-8') as file:
            file_content = file.read()
            print(file_content)

